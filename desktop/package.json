{
  "name": "video-tool-desktop",
  "productName": "Video Tool",
  "version": "1.0.0",
  "description": "Turn a voice recording or a typed script into a faceless explainer video. Free and open source.",
  "author": "Video Tool",
  "license": "Apache-2.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:repo": "set VT_USE_REPO=1&& electron .",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.videotool.studio",
    "productName": "Video Tool",
    "copyright": "Apache-2.0",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "bootstrap.js", "discover.js", "assistants.js", "mcp-bridge.js", "preload.js", "main-preload.js", "splash.html", "connect.html", "package.json"],
    "asarUnpack": ["node_modules/ffmpeg-static/**", "node_modules/ffprobe-static/**", "mcp-bridge.js"],
    "extraResources": [
      {
        "from": "..",
        "to": "app-src",
        "filter": [
          "vt/**/*", "design/**/*", "assets/**/*", "renderer/**/*", "studio/dist/**/*", "scripts/**/*", "pyproject.toml", "README.md",
          "!**/__pycache__/**", "!**/*.pyc", "!renderer/node_modules/**", "!assets/music/user/**", "!design/themes/*-2/**"
        ]
      }
    ],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.ico" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "Video Tool" },
    "mac": { "target": ["dmg"], "category": "public.app-category.video", "icon": "build/icon.png" },
    "linux": { "target": ["AppImage", "deb"], "category": "AudioVideo", "icon": "build/icon.png", "maintainer": "Video Tool" }
  }
}
